# =============================================
# Database
# =============================================
# postgres container è raggiungibile per nome sulla rete 'backend'
DATABASE_URL=postgresql://postgres:password@postgres:5432/wiki_rag

# NOTA: creare il database prima di avviare:
#   docker exec -it postgres psql -U postgres -c "CREATE DATABASE wiki_rag;"
#   docker exec -it postgres psql -U postgres -d wiki_rag -c "CREATE EXTENSION IF NOT EXISTS vector;"
# Poi eseguire le migrazioni: docker exec RAG npm run db:push

# =============================================
# NextAuth
# =============================================
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# =============================================
# Credenziali admin
# =============================================
ADMIN_USERNAME=admin
# Genera l'hash bcrypt con:
#   docker run --rm node:22-alpine node -e "const b=require('bcryptjs');console.log(b.hashSync('tuapassword',10))"
ADMIN_PASSWORD_HASH=$2a$10$CHANGEME

# =============================================
# Ollama
# =============================================
# Se Ollama gira su un container nella rete backend:
OLLAMA_BASE_URL=http://ollama:11434
# Se gira sull'host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# =============================================
# OpenAI (opzionale, per switch modello nel chat)
# =============================================
OPENAI_API_KEY=sk-...
# Modello da usare (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
